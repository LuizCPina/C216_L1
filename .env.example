# Copie para .env e ajuste. O .env nao vai para o git.
# Sem .env, o compose usa os mesmos valores abaixo como padrao.

# Banco de dados
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Porta do Postgres na sua maquina (troque se a 5432 ja estiver em uso)
POSTGRES_PORT=5432

# Endereco da API visto pelo navegador. Entra no build do frontend (servico web).
VITE_API_URL=http://localhost:8000

# Enderecos do frontend que podem chamar a API pelo navegador, separados por virgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
