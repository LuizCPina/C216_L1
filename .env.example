# Copie para .env e ajuste. O .env nao vai para o git.

# Credenciais do contêiner do PostgreSQL (lidas pelo compose.yaml).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Conexao usada pela aplicacao e pelo Alembic.
# Dentro do compose o host e o nome do servico: db
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# Rodando a API na maquina local (make run) com so o banco no Docker,
# troque o host por localhost:
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
